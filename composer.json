{
    "name": "charlesmasinde/api-scaffolder",
    "description": "Generate full API modules (Controller, Requests, Resource, Policy, Routes) from Eloquent models.",
    "keywords": [
        "laravel",
        "api",
        "scaffold",
        "generator",
        "crud"
    ],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/filesystem": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "CharlesMasinde\\ApiScaffolder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CharlesMasinde\\ApiScaffolder\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CharlesMasinde\\ApiScaffolder\\ApiScaffolderServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}